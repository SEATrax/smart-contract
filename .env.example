# Export-Import Funding Platform Environment Variables

# ================================
# DEPLOYMENT CONFIGURATION
# ================================

# Private key for deployment (use with caution, never commit real keys)
# For LOCAL DEVELOPMENT: Use Foundry's default test account
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admin address (defaults to deployer if not set)
# For LOCAL DEVELOPMENT: Use Foundry's default test account address
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Investment Manager address (defaults to deployer if not set)
INVESTMENT_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890

# ================================
# NETWORK RPC URLs
# ================================

# Lisk Sepolia Testnet (Primary Deployment Network)
LISK_SEPOLIA_RPC_URL=https://rpc.sepolia-api.lisk.com
LISK_SEPOLIA_CHAIN_ID=4202

# Alternative Testnets (for testing)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
GOERLI_RPC_URL=https://eth-goerli.alchemyapi.io/v2/your-api-key

# Mainnet (for future production)
MAINNET_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your-api-key

# ================================
# BLOCK EXPLORER URLs
# ================================

# Lisk Sepolia Blockscout
LISK_SEPOLIA_EXPLORER=https://sepolia-blockscout.lisk.com

# Etherscan (for other networks)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ================================
# CONTRACT CONFIGURATION
# ================================

# Platform fee in basis points (100 = 1%)
PLATFORM_FEE_PERCENT=100

# Investor yield in basis points (400 = 4%)
INVESTOR_YIELD_PERCENT=400

# Funding thresholds
ELIGIBILITY_THRESHOLD_PERCENT=7000  # 70%
AUTO_DISBURSEMENT_THRESHOLD_PERCENT=10000  # 100%

# ================================
# ORACLE CONFIGURATION
# ================================

# Oracle update frequency (in seconds)
ORACLE_UPDATE_INTERVAL=3600

# Oracle admin address
ORACLE_ADMIN_ADDRESS=0x1234567890123456789012345678901234567890

# ================================
# TESTING CONFIGURATION
# ================================

# Fork testing (use Lisk Sepolia for fork tests)
FORK_URL=$LISK_SEPOLIA_RPC_URL
FORK_BLOCK_NUMBER=

# Test addresses
TEST_EXPORTER_ADDRESS=0x1111111111111111111111111111111111111111
TEST_IMPORTER_ADDRESS=0x2222222222222222222222222222222222222222
TEST_INVESTOR_ADDRESS=0x3333333333333333333333333333333333333333
TEST_INVESTMENT_MANAGER_ADDRESS=0x4444444444444444444444444444444444444444